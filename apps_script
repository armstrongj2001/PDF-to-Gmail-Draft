// ------------------------------------------------------------
// Contacts Log — returns the "DHC Contacts Log" spreadsheet,
// creating it (with headers) on first run and storing its ID
// in Script Properties so it persists across executions.
// ------------------------------------------------------------
function getOrCreateContactsLog() {
  var props = PropertiesService.getScriptProperties();
  var logId = props.getProperty('CONTACTS_LOG_ID');

  if (logId) {
    try {
      return SpreadsheetApp.openById(logId);
    } catch (e) {
      // Sheet was deleted or moved — fall through to recreate it
    }
  }

  // Create the spreadsheet and move it into the DHC Sites folder
  var newLog = SpreadsheetApp.create('DHC Contacts Log');
  DriveApp.getFileById(newLog.getId()).moveTo(DriveApp.getFolderById(DHC_SITES_FOLDER_ID));

  // Set up the header row
  var logSheet = newLog.getActiveSheet();
  logSheet.setName('Contacts');
  logSheet.appendRow([
    'Timestamp',
    'Client Name',
    'Client Email',
    'Client Phone',
    'Client Address',
    'County',
    'Project Name',
    'Estimate #',
    'Estimate Date',
    'Job Type',
    'Spreadsheet Title'
  ]);
  logSheet.setFrozenRows(1);
  logSheet.getRange(1, 1, 1, 11).setFontWeight('bold');

  props.setProperty('CONTACTS_LOG_ID', newLog.getId());
  return newLog;
}


// ------------------------------------------------------------
// Appends one row of client data to the contacts log.
// Reads from the header block in column K (rows 3–10).
// jobType is either 'Estimate' or 'Invoice'.
// ------------------------------------------------------------
function logClientContact(activeSheet, spreadsheet, jobType) {
  var projectName   = activeSheet.getRange('K3').getValue();
  var clientName    = activeSheet.getRange('K4').getValue();
  var clientAddress = activeSheet.getRange('K5').getValue();
  var clientEmail   = activeSheet.getRange('K6').getValue();
  var clientPhone   = activeSheet.getRange('K7').getValue();
  var estimateDate  = activeSheet.getRange('K8').getValue();
  var estimateNum   = activeSheet.getRange('K9').getValue();
  var county        = activeSheet.getRange('K10').getValue();

  var timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm:ss");

  var logSheet = getOrCreateContactsLog().getSheetByName('Contacts');
  logSheet.appendRow([
    timestamp,
    clientName,
    clientEmail,
    clientPhone,
    clientAddress,
    county,
    projectName,
    estimateNum,
    estimateDate,
    jobType,
    spreadsheet.getName()
  ]);
}


// ------------------------------------------------------------
// Sends new-folder notification to all NOTIFICATION_EMAILS.
// ------------------------------------------------------------
function sendFolderNotifications(folderName) {
  var subject = "New Folder Created: " + folderName;
  var body = "A new folder named '" + folderName + "' has been created in DHC Sites and the spreadsheet has been moved to the Estimates subfolder.";
  NOTIFICATION_EMAILS.forEach(function(email) {
    GmailApp.sendEmail(email, subject, body);
  });
}


// ------------------------------------------------------------
// Main action: create PDF, organize in Drive, draft client
// email, log contact info, and notify team on new folders.
// ------------------------------------------------------------
function createEmailDraftWithPdf() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet();
  var activeSheet = sheet.getActiveSheet();
  var sheetId = sheet.getId();

  // Project / folder name lives in K3
  var folderName = activeSheet.getRange('K3').getValue() || 'Default Folder';

  var dhcSitesFolder = DriveApp.getFolderById(DHC_SITES_FOLDER_ID);

  var folderIterator = dhcSitesFolder.getFoldersByName(folderName);
  var isNewFolder = !folderIterator.hasNext();
  var mainFolder = isNewFolder ? dhcSitesFolder.createFolder(folderName) : folderIterator.next();

  var subFolderNames = ['Bids', 'Drawings-Prints', 'Estimates', 'Invoices', 'Materials', 'Permits', 'Pictures', 'SOW', 'Subcontractor Agreement Form'];
  var subFolders = {};
  subFolderNames.forEach(function(name) {
    var existingSubFolder = mainFolder.getFoldersByName(name);
    subFolders[name] = existingSubFolder.hasNext() ? existingSubFolder.next() : mainFolder.createFolder(name);
  });

  // Generate and fetch the PDF
  var url = 'https://docs.google.com/spreadsheets/d/' + sheetId + '/export?' +
    'exportFormat=pdf&format=pdf' +
    '&size=letter' +
    '&portrait=true' +
    '&fitw=true' +
    '&sheetnames=false&printtitle=false' +
    '&pagenumbers=false&gridlines=false' +
    '&fzr=false' +
    '&gid=' + activeSheet.getSheetId();

  var token = ScriptApp.getOAuthToken();
  var response = UrlFetchApp.fetch(url, { headers: { 'Authorization': 'Bearer ' + token } });

  var timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyyMMddHHmmss");
  var pdfFilename = sheet.getName() + ' - ' + activeSheet.getName() + ' - ' + timestamp + '.pdf';
  var pdfBlob = response.getBlob().setName(pdfFilename);

  // Route PDF to correct subfolder
  var isInvoice = activeSheet.getName() === 'Invoice & Change Orders';
  var targetSubFolder = isInvoice ? subFolders['Invoices'] : subFolders['Estimates'];
  targetSubFolder.createFile(pdfBlob);

  // Move the spreadsheet file into Estimates
  DriveApp.getFileById(sheetId).moveTo(subFolders['Estimates']);

  // Create client email draft — email address is in K6
  var emailAddress = activeSheet.getRange('K6').getValue();
  var emailSubject = sheet.getName() + ' - ' + activeSheet.getName() + '.pdf';
  var emailBody = "Good evening,\n\nIt was great meeting you today and Thank you for the opportunity to earn your business.\n\nAttached is the estimate for the full scope of work that we discussed, including all materials.\n\nPlease let me know if you have any questions or if any revisions need to be made, I am available to take a call if needed.\n\nWe do have a crew available to start this project at your approval, we are looking forward to helping you with this project.\nThank you!";

  if (emailAddress) {
    GmailApp.createDraft(emailAddress, emailSubject, emailBody, { attachments: [pdfBlob] });
    SpreadsheetApp.getUi().alert('A draft email with the attached PDF has been created for ' + emailAddress + '.');
  } else {
    SpreadsheetApp.getUi().alert('No email address found in cell K6. Draft creation canceled.');
  }

  // Log client contact info for record keeping / Salesforce
  var jobType = isInvoice ? 'Invoice' : 'Estimate';
  logClientContact(activeSheet, sheet, jobType);

  // Notify the whole team when a brand-new project folder is created
  if (isNewFolder) {
    sendFolderNotifications(folderName);
  }
}


function createDownloadLink() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet();
  var sheetId = sheet.getId();
  var activeSheet = sheet.getActiveSheet();

  var url = 'https://docs.google.com/spreadsheets/d/' + sheetId + '/export?' +
    'exportFormat=pdf&format=pdf' +
    '&size=letter' +
    '&portrait=true' +
    '&fitw=true' +
    '&sheetnames=false&printtitle=false' +
    '&pagenumbers=false&gridlines=false' +
    '&fzr=false' +
    '&gid=' + activeSheet.getSheetId();

  var htmlOutput = HtmlService.createHtmlOutput(
    '<a href="' + url + '" download="' + sheet.getName() + ' - ' + activeSheet.getName() + '.pdf" target="_blank">Download PDF</a>'
  ).setWidth(200).setHeight(100);

  SpreadsheetApp.getUi().showModalDialog(htmlOutput, 'Download PDF');
}


